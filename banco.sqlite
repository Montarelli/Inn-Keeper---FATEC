CREATE TABLE Cadclientes(
    idcliente INTEGER PRIMARY KEY,
    cpf TEXT NOT NULL UNIQUE,
    nome VARCHAR(50) NOT NULL,
    login VARCHAR(50) NOT NULL UNIQUE,
    senha TEXT NOT NULL,
	email varchar(50));


CREATE TABLE recuperacao_senha (
    idrecuperacao INTEGER PRIMARY KEY AUTOINCREMENT,
    idcliente INTEGER NOT NULL,
    token_hash TEXT NOT NULL,
    expiracao INTEGER NOT NULL,
    usado INTEGER DEFAULT 0, tentativas INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (idcliente) REFERENCES Cadclientes(idcliente)
)

CREATE TABLE sqlite_sequence(name,seq)
